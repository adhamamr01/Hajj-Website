# Base URL of the deployed Spring Boot backend.
# In development this is unused — Vite proxies /api to localhost:8080.
# Set this in Netlify environment variables for production.
VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Pre-launch "link-only" mode: set to true so pages open only through secret
# /p/<token> links (no navigation, everything else shows "not available").
# Also set SITE_LINK_ONLY=true on the backend, which enforces it server-side.
# Remove or set to false (and redeploy) to launch.
VITE_LINK_ONLY=false
